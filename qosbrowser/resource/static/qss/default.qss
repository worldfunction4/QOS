/* 白色主背景与默认字体 */
* {
    background-color: #ffffff;
    color: #455a64;
    font-family: "微软雅黑";
    font-size: 10pt;
}

/* 标题字体 */
*[style="h1"] {
    color: #111111;
    font: bold 25pt;
}
*[style="h2"] {
    color: #222222;
    font: bold 22pt;
}
*[style="h3"] {
    color: #333333;
    font: bold 20pt;
}
*[style="h4"] {
    color: #444444;
    font: bold 16pt;
}
*[style="h5"] {
    color: #455a64;
    font: bold 12pt;
}

/* 输入框 */
QLineEdit {
    height: 28px;
    border: 1px solid #cfd8dc;
    border-radius: 2px;
    selection-background-color: #00bcd4;
    selection-color: #ffffff;
}
QLineEdit:focus {
    border-color: #00bcd4;
}

/* 复选框 */
QCheckBox {
    background-color: transparent;
}
QCheckBox::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid #90a4ae;
    background-color: #ffffff;
    border-radius: 2px;
}
QCheckBox::indicator:checked {
    background-color: #00bcd4;
    border-color: #00bcd4;
}

/* 通用按钮 */
QPushButton {
    width: 56px;
    height: 28px;
    background-color: #ffffff;
    border: 1px solid #cfd8dc;
    border-radius: 2px;
}
QPushButton:hover {
    color: #00acc1;
    border-color: #00bcd4;
    background-color: #e0f7fa;
}
QPushButton:pressed {
    color: #ffffff;
    border-color: #0097a7;
    background-color: #0097a7;
}

/* 登录主按钮 */
QPushButton#loginButton {
    color: #ffffff;
    background-color: #00bcd4;
    border-color: #00bcd4;
    font: bold 12pt;
}
QPushButton#loginButton:hover {
    background-color: #00acc1;
    border-color: #00acc1;
}
QPushButton#loginButton:pressed {
    background-color: #0097a7;
    border-color: #0097a7;
}

/* 左右分栏的拖动条 */
QSplitter::handle {
    background-color: #b2ebf2;
}
QSplitter::handle:horizontal {
    width: 2px;
}
QSplitter::handle:vertical {
    height: 2px;
}

/* 左侧栏：右边一条线，并且不要被压没 */
#widget {
    border-right: 1px solid #b2ebf2;
    min-width: 180px;
}

/* 右侧各层之间的横线 */
#widgetToolBar,
#widgetBread {
    border-bottom: 1px solid #b2ebf2;
}

#widgetPage {
    border-top: 1px solid #b2ebf2;
    min-height: 36px;
}

/* 列表与表格 */
QListView,
QTableView {
    border: 1px solid #cfd8dc;
    background-color: #ffffff;
    gridline-color: #eceff1;
    selection-background-color: #b2ebf2;
    selection-color: #263238;
}

/* 格子：悬停浅青，选中更深一点的青色 */
QListView::item:hover,
QTableView::item:hover {
    background-color: #e0f7fa;
}
QListView::item:selected,
QTableView::item:selected {
    background-color: #b2ebf2;
    color: #263238;
}


QHeaderView::section {
    color: #455a64;
    background-color: #ffffff;
    border: none;
    border-right: 1px solid #eceff1;
    border-bottom: 1px solid #b2ebf2;
    padding: 4px;
}

/* 下拉框 */
QComboBox {
    height: 28px;
    background-color: #ffffff;
    border: 1px solid #cfd8dc;
    border-radius: 2px;
    padding-left: 6px;
}
QComboBox:hover,
QComboBox:focus {
    border-color: #00bcd4;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #00bcd4;
    selection-background-color: #b2ebf2;
    selection-color: #263238;
}