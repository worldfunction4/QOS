/* 白色主背景与默认字体 */
* {
    background-color: #ffffff;
    color: #455a64;
    font-family: "微软雅黑";
    font-size: 10pt;
}

/* 标题字体 */
*[style_font="h1"] {
    color: #111111;
    font: bold 25pt;
}
*[style_font="h2"] {
    color: #222222;
    font: bold 22pt;
}
*[style_font="h3"] {
    color: #333333;
    font: bold 20pt;
}
*[style_font="h4"] {
    color: #444444;
    font: bold 16pt;
}
*[style_font="h5"] {
    color: #455a64;
    font: bold 12pt;
}

*[style_frame="bottomframe"] {
    border: none;
    border-bottom: 1px solid #b2ebf2;
    border-radius: 0px;
}

/* 输入框 */
QLineEdit {
    height: 28px;
    border: 1px solid #cfd8dc;
    border-radius: 2px;
    selection-background-color: #00bcd4;
    selection-color: #ffffff;
}
QLineEdit:focus {
    border-color: #00bcd4;
}

/* 复选框 */
QCheckBox {
    background-color: transparent;
}
QCheckBox::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid #90a4ae;
    background-color: #ffffff;
    border-radius: 2px;
}
QCheckBox::indicator:checked {
    background-color: #00bcd4;
    border-color: #00bcd4;
}

/* 通用按钮 */
QPushButton {
    width: 56px;
    height: 28px;
    background-color: #ffffff;
    border: 1px solid #cfd8dc;
    border-radius: 2px;
}
QPushButton:hover {
    color: #00acc1;
    border-color: #00bcd4;
    background-color: #e0f7fa;
}
QPushButton:pressed {
    color: #ffffff;
    border-color: #0097a7;
    background-color: #0097a7;
}

/* 主按钮：带 style_button="main" 标签的按钮 */
QPushButton[style_button="main"] {
    color: #ffffff;
    background-color: #00bcd4;
    border-color: #00bcd4;
}
QPushButton[style_button="main"]:hover {
    background-color: #00acc1;
    border-color: #00acc1;
}
QPushButton[style_button="main"]:pressed {
    background-color: #0097a7;
    border-color: #0097a7;
}

/* 按钮禁用时变灰 */
QPushButton:disabled {
    color: #b0bec5;
    background-color: #eceff1;
    border-color: #cfd8dc;
}

/* 左右分栏的拖动条 */
QSplitter::handle {
    background-color: #b2ebf2;
}
QSplitter::handle:horizontal {
    width: 2px;
}
QSplitter::handle:vertical {
    height: 2px;
}

/* 左侧栏：右边一条线，并且不要被压没 */
#widget {
    border-right: 1px solid #b2ebf2;
    min-width: 180px;
}

/* 右侧各层之间的横线 */
#widgetToolBar,
#widgetBread {
    border-bottom: 1px solid #b2ebf2;
}

#widgetPage {
    border-top: 1px solid #b2ebf2;
    min-height: 36px;
}

/* 列表与表格 */
QListView,
QTableView {
    border: 1px solid #cfd8dc;
    background-color: #ffffff;
    gridline-color: #eceff1;
    selection-background-color: #b2ebf2;
    selection-color: #263238;
    outline: none;
}

/* 格子：悬停浅青，选中更深一点的青色 */
QListView::item:hover,
QTableView::item:hover {
    background-color: #e0f7fa;
}
QListView::item:selected,
QTableView::item:selected {
    background-color: #b2ebf2;
    color: #263238;
}

/* 列表每一行的高度（左边桶列表） */
QListView::item {
    height: 30px;
    padding-left: 6px;
}

/* 面包屑：无边框、透明背景，只用文字颜色区分状态 */
QListView[style_list="bread"] {
    border: none;
    background: transparent;
}
QListView[style_list="bread"]::item {
    height: 28px;
    color: #666666;
    border: none;
    padding: 0px;
    padding-right: 2px;
}
QListView[style_list="bread"]::item:hover {
    color: #333333;
    background: transparent;
}
QListView[style_list="bread"]::item:selected {
    color: #000000;
    background: transparent;
}


QHeaderView::section {
    color: #455a64;
    background-color: #ffffff;
    border: none;
    border-right: 1px solid #eceff1;
    border-bottom: 1px solid #b2ebf2;
    padding: 4px;
}

/* 下拉框 */
QComboBox {
    height: 28px;
    background-color: #ffffff;
    border: 1px solid #cfd8dc;
    border-radius: 2px;
    padding-left: 6px;
}

/* 在文字右边流出18像素 */
QComboBox {
    padding-right: 18px;
}

/* 下拉框最右边可点区域 */
QComboBox::drop-down {
    border: none;
    width: 18px;
    background-color: #ffffff;
}

/* 用边框拼出三角 */
QComboBox::down-arrow {
    width: 0px;
    height: 0px;
    border-style: solid;
    border-width: 5px 4px 0px 4px;
    border-color: #455a64 #ffffff #ffffff #ffffff;
}

QComboBox:hover,
QComboBox:focus {
    border-color: #00bcd4;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #00bcd4;
    selection-background-color: #b2ebf2;
    selection-color: #263238;
}

/* 滚动条：细一点，两端的箭头不要 */
QScrollBar {
    border: none;
    background-color: transparent;
}
QScrollBar:horizontal {
    height: 6px;
}
QScrollBar:vertical {
    width: 6px;
}
QScrollBar::handle {
    background: #aaaaaa;
    border-radius: 3px;
}
QScrollBar::add-line, QScrollBar::sub-line {
    border: none;
}

/* 进度条：槽用浅青，走过的一段用主题色 */
QProgressBar {
    background: #e0f7fa;
    border-radius: 3px;
}
QProgressBar::chunk {
    background: #00bcd4;
    border-radius: 3px;
}

/* 传输窗口的标签页不再套一层边框 */
QTabWidget::pane {
    border: none;
}

/* 提示文字：灰色，比如创建桶时输入框右边的账号编号 */
*[style_font="tip"] {
    color: #999;
}