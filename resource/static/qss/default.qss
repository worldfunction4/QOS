/*设置QLineEdit样式*/
QLineEdit{
	/*边框设置为浅灰色*/
	border: 1px solid #cccccc;
	/*圆角*/
	border-radius： 2px;
	selection-background-color: darkgray;
	height: 28px
}

/*勾选框恢复框*/
QCheckBox {
    background-color: transparent;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid #777777;
    background-color: #ffffff;
    border-radius: 2px;
}

QCheckBox::indicator:checked {
    background-color: #555555;
    border: 1px solid #555555;
}

/*通用按钮设置*/
QPushButton{
	background: transparent;
	border: 1px solid #dddddd;
	border-radius: 2px;
	height: 28px;
	width: 56px;
}
QPushButton:hover{
	color:#1296db;
	border-color: #1296db;
}

QPushButton#loginButton{
	background: #1296db;
	color:white;
    font: bold 12pt;
}