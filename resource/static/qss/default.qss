/*设置默认样式*/
*{
/*白色背景*/
background-color:white;
/*字体*/
font-family: "微软雅黑";
font-size: 10pt;
color: #555555
}

/*设置*/
*[style="h1"]{
font: bold 25pt;
color: #111111
}
*[style="h2"]{
font: bold 22pt;
color: #222222
}
*[style="h3"]{
font: bold 20pt;
color: #333333
}
*[style="h4"]{
font: bold 16pt;
color: #444444
}
*[style="h5"]{
font: bold 12pt;
color: #555555
}

/*设置默认样式*/
*{
/*白色背景*/
background-color:white;
/*字体*/
font-family: "微软雅黑";
font-size: 10pt;
color: #555555
}

/*设置*/
*[style="h1"]{
font: bold 25pt;
color: #111111
}
*[style="h2"]{
font: bold 22pt;
color: #222222
}
*[style="h3"]{
font: bold 20pt;
color: #333333
}
*[style="h4"]{
font: bold 16pt;
color: #444444
}
*[style="h5"]{
font: bold 12pt;
color: #555555
}

/*设置QLineEdit样式*/
QLineEdit{
	/*边框设置为浅灰色*/
	border: 1px solid #cccccc;
	/*圆角*/
	border-radius： 2px;
	selection-background-color: darkgray;
	height: 28px
}

/*勾选框恢复框*/
QCheckBox {
    background-color: transparent;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid #777777;
    background-color: #ffffff;
    border-radius: 2px;
}

QCheckBox::indicator:checked {
    background-color: #555555;
    border: 1px solid #555555;
}

/*通用按钮设置*/
QPushButton{
	background: transparent;
	border: 1px solid #dddddd;
	border-radius: 2px;
	height: 28px;
	width: 56px;
}
QPushButton:hover{
	color:#1296db;
	border-color: #1296db;
}

QPushButton#loginButton{
	background: #1296db;
	color:white;
    font: bold 12pt;
}

/* 左右分栏的拖动条 */
QSplitter::handle {
    background-color: #cccccc;
}
QSplitter::handle:horizontal {
    width: 2px;
}
QSplitter::handle:vertical {
    height: 2px;
}

/* 左侧栏：右边一条线，并且不要被压没 */
#widget {
    border-right: 1px solid #cccccc;
    min-width: 180px;
}

/* 右侧各层之间的横线 */
#widgetToolBar,
#widgetBread {
    border-bottom: 1px solid #cccccc;
}

#widgetPage {
    border-top: 1px solid #cccccc;
    min-height: 36px;
}

/* 空列表/空表格也要看得见边界 */
QListView,
QTableView {
    border: 1px solid #dddddd;
    background-color: #ffffff;
    gridline-color: #eeeeee;
}