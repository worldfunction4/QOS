/*设置默认样式*/
*{
/*白色背景*/
background-color:white;
/*字体*/
font-family: "微软雅黑";
font-size: 10pt;
color: #555555
}

/*设置*/
*[style="h1"]{
font: bold 25pt;
color: #111111
}
*[style="h2"]{
font: bold 22pt;
color: #222222
}
*[style="h3"]{
font: bold 20pt;
color: #333333
}
*[style="h4"]{
font: bold 16pt;
color: #444444
}
*[style="h5"]{
font: bold 12pt;
color: #555555
}

